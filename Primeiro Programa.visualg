algoritmo "Primeiro Programa do curso (que eu fiz)"

var

nums1 : vetor [0..5] de inteiro
nums2 : vetor [0..5] de inteiro
cont : inteiro

inicio
// Seção de Comandos

para cont de 0 ate 5 faca
    escreval ("Digite um número: ")
    leia (nums1 [cont])
    nums2 [cont] <- nums1 [cont] * 5
fimpara
escreva ()
escreval ("Resultado: ")
para cont de 0 ate 5 faca
   escreval (nums1 [cont], " ", nums2[cont])
fimpara
escreval ()   

fimalgoritmo
